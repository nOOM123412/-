# ===== БАЗА ДАННЫХ =====
def init_db():
    conn = sqlite3.connect(DB)
    conn.execute("CREATE TABLE IF NOT EXISTS cart (chat_id INTEGER, item TEXT)")
    conn.commit()
    conn.close()

def add_to_cart(chat_id, item):
    conn = sqlite3.connect(DB)
    conn.execute("INSERT INTO cart VALUES (?,?)", (chat_id, item))
    conn.commit()
    conn.close()

def get_cart(chat_id):
    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute("SELECT item FROM cart WHERE chat_id=?", (chat_id,))
    items = [r[0] for r in cur.fetchall()]
    conn.close()
    return items

def clear_cart(chat_id):
    conn = sqlite3.connect(DB)
    conn.execute("DELETE FROM cart WHERE chat_id=?", (chat_id,))
    conn.commit()
    conn.close()

