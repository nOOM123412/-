# ===== API CRYPTOBOT =====
def crypto_api(method, params=None):
    url = f"https://pay.cryptobot.it/api/{method}"
    headers = {"Crypto-Pay-API-Token": CRYPTO_TOKEN, "Content-Type": "application/json"}
    payload = json.dumps(params).encode("utf-8") if params else None
    req = urllib.request.Request(url, data=payload, headers=headers, method="POST" if params else "GET")
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except: return {"ok": False}

def create_invoice(amount_rub):
    amount_usdt = round(amount_rub / 95, 2)
    params = {"asset": "USDT", "amount": str(amount_usdt), "description": "Order"}
    res = crypto_api("createInvoice", params)
    return res["result"]["pay_url"] if res.get("ok") else None

# ===== TELEGRAM API =====
def api_call(method, data=None, files=None):
    url = f"https://api.telegram.org/bot{TOKEN}/{method}"
    if files:
        boundary = "----WebKitFormBoundary7MA4YWxkTrZu0gW"
        body = []
        for k, v in data.items():
            body.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode())
        for k, filepath in files.items():
            with open(filepath, "rb") as f:
                content = f.read()
            body.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"; filename=\"{os.path.basename(filepath)}\"\r\nContent-Type: image/jpeg\r\n\r\n".encode())
            body.append(content + b"\r\n")
        body.append(f"--{boundary}--\r\n".encode())
        req = urllib.request.Request(url, data=b"".join(body), headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    else:
        payload = json.dumps(data).encode("utf-8") if data else None
        req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except: return {"ok": False}

def send_msg(chat_id, text, markup=None):
    return api_call("sendMessage", {"chat_id": chat_id, "text": text, "parse_mode": "HTML", "reply_markup": markup})

def send_product(chat_id, code):
    if code not in ALL_PRODUCTS: return
    name, price, desc = ALL_PRODUCTS[code]
    photo_path = os.path.join(SHARED_DIR, f"{code}.jpg")
    caption = f"<b>{name}</b>\n\n{desc}\n\n<b>Цена:</b> {price}₽"
    markup = {"inline_keyboard": [[{"text":"➕ В корзину","callback_data":"add_"+code}],[{"text":"◀ Назад","callback_data":"shops"}]]}
    
    if os.path.exists(photo_path):
        api_call("sendPhoto", data={"chat_id": chat_id, "caption": caption, "parse_mode": "HTML", "reply_markup": json.dumps(markup)}, files={"photo": photo_path})
    else:
        send_msg(chat_id, caption + "\n\n<i>(Фото не найдено)</i>", markup)

