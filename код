def show_cart(chat_id):
    items = get_cart(chat_id)
    if not items: return send_msg(chat_id, "🧺 Корзина пуста.", {"inline_keyboard":[[{"text":"◀ Меню","callback_data":"main"}]]})
    total = sum([ALL_PRODUCTS[i][1] for i in items if i in ALL_PRODUCTS])
    text = "<b>🧺 Корзина:</b>\n" + "\n".join([f"• {ALL_PRODUCTS[i][0]} — {ALL_PRODUCTS[i][1]}₽" for i in items if i in ALL_PRODUCTS])
    text += f"\n\n<b>Итого: {total}₽</b>"
    markup = {"inline_keyboard":[[{"text":"💳 Оплатить","callback_data":"pay"}],[{"text":"🗑 Очистить","callback_data":"clear"},{"text":"◀ Меню","callback_data":"main"}]]}
    send_msg(chat_id, text, markup)

def handle_update(u):
    if "message" in u:
        cid = u["message"]["chat"]["id"]
        if u["message"].get("text") == "/start":
            send_msg(cid, "<b>Главное меню:</b>", {"inline_keyboard":[[{"text":"🛍 Магазин","callback_data":"shops"}],[{"text":"🧺 Корзина","callback_data":"cart"}]]})
    elif "callback_query" in u:
        cb = u["callback_query"]; cid = cb["message"]["chat"]["id"]; data = cb["data"]
        api_call("answerCallbackQuery", {"callback_query_id": cb["id"]})
        
        if data == "main": send_msg(cid, "Меню:", {"inline_keyboard":[[{"text":"🛍 Магазин","callback_data":"shops"}],[{"text":"🧺 Корзина","callback_data":"cart"}]]})
        elif data == "shops": 
            kb = [[{"text":"BDSM","callback_data":"cat_bdsm"}, {"text":"Секрет Счастья","callback_data":"cat_happiness"}],
                  [{"text":"ПАВстанция","callback_data":"cat_pav"}, {"text":"LIDERA","callback_data":"cat_lidera"}],
                  [{"text":"Yoda","callback_data":"cat_yoda"}, {"text":"YAMASAKI","callback_data":"cat_yamasaki"}],
                  [{"text":"ЦУМ","callback_data":"cat_tsum"}],
                  [{"text":"◀ Назад","callback_data":"main"}]]
            send_msg(cid, "Выберите магазин:", {"inline_keyboard": kb})
        elif data == "cart": show_cart(cid)
        elif data == "clear": clear_cart(cid); send_msg(cid, "🧺 Очищено.", {"inline_keyboard":[[{"text":"◀ Меню","callback_data":"main"}]]})
        elif data == "pay":
            items = get_cart(cid); total = sum([ALL_PRODUCTS[i][1] for i in items if i in ALL_PRODUCTS])
            url = create_invoice(total)
            if url: send_msg(cid, f"💰 К оплате: <b>{total}₽</b>", {"inline_keyboard":[[{"text":"🚀 Оплатить","url":url}]]})
        elif data.startswith("cat_"):
            cat = data.split("_")[1]
            maps = {"bdsm": BDSM_ITEMS, "happiness": HAPPINESS_ITEMS, "pav": PAV_ITEMS, "lidera": LIDERA_ITEMS, "yoda": YODA_ITEMS, "yamasaki": YAMASAKI_ITEMS, "tsum": TSUM_ITEMS}
            if cat in maps:
                kb = [[{"text": v[0], "callback_data": k}] for k, v in maps[cat].items()]
                kb.append([{"text":"◀ Назад","callback_data":"shops"}])
                send_msg(cid, "Товары:", {"inline_keyboard": kb})
        elif data in ALL_PRODUCTS: send_product(cid, data)
        elif data.startswith("add_"):
            add_to_cart(cid, data.replace("add_", "")); send_msg(cid, "✅ Товар добавлен!")

def main():
    init_db()
    print("Бот запущен...")
    last_id = 0
    while True:
        try:
            res = api_call("getUpdates", {"offset": last_id + 1, "timeout": 20})
            if res.get("ok"):
                for u in res["result"]:
                    last_id = u["update_id"]; handle_update(u)
        except: pass
        sleep(1)

if __name__ == "__main__": main()
